# Copy this file to .env for local development. NEVER put real values here.

# --- Core ---
DEBUG=True
SECRET_KEY=change-me-generate-with-python-c-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1
# SITE_URL=https://quantummanager-xmss.onrender.com
# CSRF_TRUSTED_ORIGINS=https://quantummanager-xmss.onrender.com

# --- Database (Render sets this for you) ---
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Email via Brevo HTTPS API (works on Render free) ---
# Get a key at https://app.brevo.com -> SMTP & API -> API Keys
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=you@yourdomain.com   (must be a verified sender in Brevo)
# REQUIRE_EMAIL_VERIFICATION=True

# --- File uploads (avatars, custom ringtones) ---
# Free account at https://cloudinary.com, copy the "API environment variable"
# CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# --- Fallback timezone for users whose browser hasn't reported one yet ---
# DEFAULT_USER_TIMEZONE=Africa/Lagos

# --- Alarms that ring with the app closed (Web Push) ---
# Create once with: python manage.py generate_vapid_keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Any long random string. A free scheduler calls /api/cron/tick/?key=THIS every minute.
# CRON_SECRET=
